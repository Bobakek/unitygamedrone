{
  "name": "nova-frontier",
  "version": "0.1.0",
  "private": true,
  "description": "Browser 3D space MMO: flight, combat and seamless landings on procedural planets",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "cross-env DEV=1 tsx watch src/server/main.ts",
    "dev:client": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "start": "cross-env NODE_ENV=production tsx src/server/main.ts",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "three": "0.186.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "cross-env": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "playwright": "1.56.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
